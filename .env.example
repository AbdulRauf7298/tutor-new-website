# Tutor Education Platform secure configuration example
# Do not commit real values.

TEP_GOOGLE_CLIENT_ID=your-google-client-id
TEP_GOOGLE_CLIENT_SECRET=your-google-client-secret
TEP_GOOGLE_REDIRECT_URI=https://example.com/wp-admin/admin.php?page=tep-platform-settings
TEP_GOOGLE_WORKSPACE_DOMAIN=example.com

TEP_SMTP_HOST=smtp.example.com
TEP_SMTP_PORT=587
TEP_SMTP_USER=mailer@example.com
TEP_SMTP_PASSWORD=your-smtp-password
TEP_SMTP_ENCRYPTION=tls
TEP_SMTP_FROM_EMAIL=no-reply@example.com
TEP_SMTP_FROM_NAME=Tutor Platform

TEP_DEFAULT_CURRENCY=USD
TEP_ALLOWED_CURRENCIES=PKR,USD,GBP,EUR,AED,CAD,AUD
